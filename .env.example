# 知乎自动化 Skill 环境变量配置

# === 必需 ===

# Cookie 加密密钥（32字节，hex编码）
# 生成: openssl rand -hex 32
ZHIHU_COOKIE_KEY="your_64_char_hex_key_here"

# === 可选（OpenAPI 圈子互动） ===

# 知乎 OpenAPI 凭证（仅 zhihu_bot.py 使用）
# ZHIHU_APP_KEY="your_app_key"
# ZHIHU_APP_SECRET="your_app_secret"

# === 可选（高级功能） ===

# 代理地址（反爬/IP轮换）
# ZHIHU_PROXY="http://proxy.example.com:8080"

# 打码平台 API Key（验证码自动处理）
# CAPTCHA_API_KEY="your_captcha_api_key"

# 测试模式（sandbox 或 production，默认 production）
# ZHIHU_TEST_MODE="sandbox"
